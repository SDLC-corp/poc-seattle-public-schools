# Copy the values you need into frontend/.env (never commit real keys).

# Backend API base URL, ending in /api (e.g. https://your-backend.example/api).
# Leave empty in local dev: calls go to /api and Vite proxies them to http://localhost:5000.
VITE_API_BASE_URL=

# MapTiler (school map on the dashboard)
VITE_MAPTILER_KEY=

# Microsoft Entra ID sign-in + Microsoft 365 (Outlook, SharePoint) via Microsoft Graph.
# These are public identifiers — the browser app has NO client secret.
# App registration → Authentication → add platform "Single-page application"
#   Redirect URI: http://localhost:5173/login  (and your production URL + /login)
# API permissions (Microsoft Graph, Delegated):
#   User.Read                                   — sign-in and profile
#   Mail.Read, Mail.Send, Calendars.ReadWrite   — Outlook
#   Sites.Read.All, Files.ReadWrite.All         — SharePoint (admin consent usually required)
VITE_ENTRA_CLIENT_ID=
# Directory (tenant) ID, or "organizations" to allow any work/school account
VITE_ENTRA_TENANT_ID=
# Optional. Must match a redirect URI on the app registration exactly (default: <origin>/login)
VITE_ENTRA_REDIRECT_URI=

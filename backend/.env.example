PORT=5000
CLIENT_URL=http://localhost:5173

ENTRA_API_AUDIENCE=
ENTRA_AUTHORITY_HOST=
ENTRA_REQUIRED_SCOPE=
# Server-only, read-only Entra employee import connection. Never use VITE_ for secrets.
# Must match the signed-in organization's Entra tenant. See docs/guides/entra-employee-import.md.
# Graph application permission: User.Read.All, with tenant admin consent.
ENTRA_DIRECTORY_TENANT_ID=
ENTRA_DIRECTORY_CLIENT_ID=
ENTRA_DIRECTORY_CLIENT_SECRET=



# Object ID of the Entra group whose members (including nested groups) are Tessera employees.
# Leave empty to read every user in the tenant. Needs GroupMember.Read.All when set.
# Optional if group id added only group member will be fetched if not all users will be fetched
ENTRA_DIRECTORY_SCOPE_GROUP_ID=
# ENTRA_DIRECTORY_SCOPE_GROUP_ID=
